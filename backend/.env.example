# 데이터베이스
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=addiction_society

# 스키마 자동 동기화. true는 로컬 실험 전용. 운영에서 절대 금지 (테이블 파괴 위험).
# 기본 false — 스키마 변경은 마이그레이션(npm run migration:run)으로만 한다.
DB_SYNCHRONIZE=false

# 원격 DB(Supabase 등) SSL 접속. 로컬 Postgres는 false.
DB_SSL=false

# 쿼리 로깅. true는 로컬 디버깅 전용. 운영에서는 헬스체크마다 쿼리가 찍혀 로그 오염.
DB_LOGGING=false

# 인증
# ⚠️ JWT_SECRET 필수 — 미설정 시 서버가 기동을 거부한다(AS-FIX-1).
#    이전엔 코드에 기본 비밀키 폴백이 있어 공개 레포 값으로 토큰 위조가 가능했다.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 회원가입 초대코드 (AS-FIX-1, 감사 문제 #1).
# POST /api/auth/register 는 이 값과 정확히 일치하는 inviteCode를 요구한다.
# ⚠️ 비워두면 회원가입이 완전히 차단된다(fail-closed). 잊고 배포해도 열리지 않는다.
# 첫 관리자 생성 후에는 다시 비워 두는 것을 권장.
ADMIN_INVITE_CODE=

# CORS 허용 출처(쉼표 구분). 비우면 코드 기본값 사용
# (https://addictionsociety.net, https://www.addictionsociety.net,
#  http://localhost:3000 + *.vercel.app 프리뷰 패턴)
CORS_ORIGINS=

# 서버
PORT=3001

# 외부 연동
# 정책문서 D×P 매트릭스 AI 분석 LLM (DeepSeek, OpenAI 호환).
# POST /api/policy/documents/:id/analyze 에 사용. (AS-M3-1: OPENAI_API_KEY 대체)
LLM_POLICY_API_KEY=
# 선택: 기본 https://api.deepseek.com
LLM_POLICY_BASE_URL=
# 선택: 기본 deepseek-chat
LLM_POLICY_MODEL=

# 공공데이터포털 오픈API 서비스키(선택). kcgp 지표 자동갱신 확장 시에만 필요.
# 미설정 시 collect:indicators는 검증된 큐레이션 데이터로 수집(무키).
DATA_GO_KR_SERVICE_KEY=

# PDF 지표 자동추출 크론 (AS-M3-2b/2d). 기본 비활성 — /api/indicators/health로 환경 확인 후 켠다.
# ⚠️ 추출 대상 URL·회차는 env가 아니라 sources.access_detail에 있다(AS-M3-2d).
#    새 소스/회차 추가 = sources 등록·수정. env 수정 불요.
INDICATOR_PDF_CRON_ENABLED=false
# Python 실행 파일. 미설정 시 빌드가 만든 venv(backend/pdf-venv/bin/python) →
# 없으면 시스템 python3 순으로 자동 선택한다. 보통 비워둔다.
PYTHON_BIN=
# venv 경로 재정의(선택). 기본 backend/pdf-venv
PDF_VENV_DIR=
# PDF 크론을 아예 쓰지 않을 때만 true — 빌드에서 pdfplumber 설치를 건너뛴다.
# (기본 false: 설치 실패 시 배포가 중단되어 '조용한 미설치'를 막는다)
SKIP_PDF_DEPS=false

# Statory 보고서 프록시(분석실 /lab)
STATORY_API_URL=

# 데이터 관측소 Discord 알림 (M2)
# 값이 없으면 알림은 전송되지 않고 로그로만 남습니다(크론은 정상 동작).
DISCORD_WEBHOOK_OBSERVATORY=

# Discord 검수 링크가 가리킬 API 공개 주소 (AS-PDF-RUN).
# 비우면 https://addiction-society-api.onrender.com 을 씁니다.
API_PUBLIC_URL=

# 검수 토큰 서명키 (AS-PDF-RUN, 선택).
# 비우면 JWT_SECRET에서 HMAC으로 파생합니다(두 용도의 키를 분리하기 위함).
# ⚠️ 이 값을 바꾸면 이미 발송된 검수 링크가 전부 무효가 됩니다.
REVIEW_TOKEN_SECRET=
