# 데이터베이스
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=addiction_society

# 스키마 자동 동기화. true는 로컬 실험 전용. 운영에서 절대 금지 (테이블 파괴 위험).
# 기본 false — 스키마 변경은 마이그레이션(npm run migration:run)으로만 한다.
DB_SYNCHRONIZE=false

# 원격 DB(Supabase 등) SSL 접속. 로컬 Postgres는 false.
DB_SSL=false

# 쿼리 로깅. true는 로컬 디버깅 전용. 운영에서는 헬스체크마다 쿼리가 찍혀 로그 오염.
DB_LOGGING=false

# 인증
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 서버
PORT=3001

# 외부 연동
# 정책문서 D×P 매트릭스 AI 분석 LLM (DeepSeek, OpenAI 호환).
# POST /api/policy/documents/:id/analyze 에 사용. (AS-M3-1: OPENAI_API_KEY 대체)
LLM_POLICY_API_KEY=
# 선택: 기본 https://api.deepseek.com
LLM_POLICY_BASE_URL=
# 선택: 기본 deepseek-chat
LLM_POLICY_MODEL=

# 공공데이터포털 오픈API 서비스키(선택). kcgp 지표 자동갱신 확장 시에만 필요.
# 미설정 시 collect:indicators는 검증된 큐레이션 데이터로 수집(무키).
DATA_GO_KR_SERVICE_KEY=

# PDF 지표 자동추출 크론 (AS-M3-2b). 기본 비활성 — Render의 Python·gov egress 실측 후 켠다.
INDICATOR_PDF_CRON_ENABLED=false
# kcgp 청소년 도박 실태조사 결과보고서 PDF 직접 URL(회차 갱신 시 교체)
KCGP_YOUTH_PDF_URL=
# 위 PDF의 조사 연도(period)
KCGP_YOUTH_PDF_YEAR=2024
# 관측치 원본 딥링크(source_url). 미설정 시 PDF URL 사용.
KCGP_YOUTH_SOURCE_URL=https://www.data.go.kr/data/15142248/fileData.do
# Python 실행 파일(기본 python3). 파서(tools/pdf-extract) 실행에 사용.
PYTHON_BIN=python3

# Statory 보고서 프록시(분석실 /lab)
STATORY_API_URL=

# 데이터 관측소 Discord 알림 (M2)
# 값이 없으면 알림은 전송되지 않고 로그로만 남습니다(크론은 정상 동작).
DISCORD_WEBHOOK_OBSERVATORY=
