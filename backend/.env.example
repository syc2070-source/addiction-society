# 데이터베이스
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=addiction_society

# 스키마 자동 동기화. true는 로컬 실험 전용. 운영에서 절대 금지 (테이블 파괴 위험).
# 기본 false — 스키마 변경은 마이그레이션(npm run migration:run)으로만 한다.
DB_SYNCHRONIZE=false

# 원격 DB(Supabase 등) SSL 접속. 로컬 Postgres는 false.
DB_SSL=false

# 쿼리 로깅. true는 로컬 디버깅 전용. 운영에서는 헬스체크마다 쿼리가 찍혀 로그 오염.
DB_LOGGING=false

# 인증
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 서버
PORT=3001

# 외부 연동
# OpenAI: 정책문서 D×P 매트릭스 AI 분석에 사용 (POST /api/policy/documents/:id/analyze)
OPENAI_API_KEY=
# 모델 재정의(선택). 미설정 시 코드 기본값 gpt-4o-mini
OPENAI_MODEL=

# P3~P5 파이프(요약·초안 생성)용. M3에서 도입 예정
DEEPSEEK_API_KEY=

# 자동수집(기존 스케줄러)
AUTO_COLLECT_ENABLED=true
AUTO_COLLECT_CRON=0 3 * * *
AUTO_COLLECT_TZ=Asia/Seoul

# Statory 보고서 프록시
STATORY_API_URL=
STATORY_ACADEMIC_QUERY=
STATORY_ACADEMIC_LIMIT=

# 데이터 관측소 Discord 알림 (M2)
# 값이 없으면 알림은 전송되지 않고 로그로만 남습니다(크론은 정상 동작).
DISCORD_WEBHOOK_OBSERVATORY=
